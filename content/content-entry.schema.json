{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blog content sidecar metadata",
  "type": "object",
  "required": ["collection", "title", "slug", "tags", "isPublished"],
  "properties": {
    "$schema": { "type": "string" },
    "collection": { "enum": ["posts", "challenges"] },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "publishAt": { "type": "string", "format": "date" },
    "dueAt": { "type": "string", "format": "date" },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "excerpt": { "type": "string" },
    "coverImage": { "type": "string" },
    "isTop": { "type": "boolean" },
    "isPublished": { "type": "boolean" },
    "author": { "type": "string" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "cadence": { "enum": ["weekly", "biweekly", "monthly", "irregular"] }
  },
  "allOf": [
    {
      "if": { "properties": { "collection": { "const": "posts" } } },
      "then": { "required": ["date", "category"] }
    },
    {
      "if": { "properties": { "collection": { "const": "challenges" } } },
      "then": { "required": ["publishAt", "dueAt", "difficulty", "sequence", "cadence"] }
    }
  ],
  "additionalProperties": false
}
