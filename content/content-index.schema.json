{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blog content index",
  "type": "object",
  "required": ["version", "collections", "categories", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "directory", "routeBase"],
        "properties": {
          "label": { "type": "string" },
          "directory": { "type": "string" },
          "routeBase": { "type": "string" }
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description", "color"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "collection": {
            "enum": ["posts", "challenges"]
          },
          "category": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "difficulty": {
            "enum": ["easy", "medium", "hard"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "cadence": {
            "enum": ["weekly", "biweekly", "monthly", "irregular"]
          }
        }
      }
    }
  }
}
